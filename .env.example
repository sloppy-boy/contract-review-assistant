# ============ 合同审查助手 · 环境变量示例 ============
# 复制为 .env（.env 已入 .gitignore，禁止提交）：
#   cp .env.example .env
# API key 只从环境变量读取（SPEC 2.9 安全约束）。

# --- DeepSeek API（主链路：抽取/workers/报告；复核用 thinking 档）---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# 文档中的 "v4-flash 档" 映射到真实 API 模型名（可按需覆盖）
DEEPSEEK_MODEL=deepseek-chat
# 复核 "thinking 档"
DEEPSEEK_REVIEWER_MODEL=deepseek-reasoner
# 成本单价（元/百万 tokens，按实际 usage 计费）
DEEPSEEK_PRICE_IN=2.0
DEEPSEEK_PRICE_OUT=8.0
DEEPSEEK_REVIEWER_PRICE_IN=4.0
DEEPSEEK_REVIEWER_PRICE_OUT=16.0

# --- 硅基流动 SiliconFlow（法条嵌入 bge-m3 硬依赖 + 盲标 Qwen）---
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_EMBED_MODEL=BAAI/bge-m3
SILICONFLOW_LABEL_MODEL=Qwen/Qwen3.5-122B-A10B

# --- 消融/复核配置 ---
# A 无复核 / B 复核直滤 / C 复核+打回重证（及格线以 C 档为准）
REVIEW_MODE=C
# 复核查证模式（默认开；1/0）
VERIFY_MODE=1

# --- 输入硬预算（SPEC 2.3）---
WORKER_INPUT_BUDGET_TOKENS=8000
TOP_K_ARTICLES=3
REF_SUMMARY_MAX_SENTENCES=3

# --- 并发控制（多 Agent 并行）---
# LLM 进程级并发上限（13 个 worker 扇出 + 多流水线并行时防 429 限流）
LLM_MAX_CONCURRENT=8
# FastAPI 同时运行的流水线数（多用户上传时排队执行）
PIPELINE_MAX_CONCURRENT=2
